# Rust / Cargo build output
target/
**/target/

# Containerized-build cache (created by ./run.sh)
.docker-cache/

# Trunk web-build output (bl2-gui)
dist/
**/dist/

# JetBrains RustRover
.idea/

# Save backups written next to an edited file
**/*.sav.bak

# Real save copies — keep personal saves (and Steam ID) out of the public repo
samples/*.sav

# Gibbed UI reference screenshots (copyrighted — local reference only)
gibbed editor pictures/

# profile.bin samples (personal, like .sav)
samples/*.bin
