# Rust / Cargo build output
target/
**/target/

# Containerized-build cache (created by ./run.sh)
.docker-cache/

# Trunk web-build output (bl2-gui)
dist/
**/dist/

# JetBrains RustRover
.idea/

# Real saves and profiles — ANYWHERE in the tree, not just samples/. A save
# carries your character name and GUID and normally lives in a folder named
# after your SteamID64, so none of it belongs in a public repo. Scoping this to
# samples/ once let a stray save elsewhere get committed.
**/*.sav
**/*.sav.bak
**/*.bin

# Gibbed UI reference screenshots (copyrighted — local reference only)
gibbed editor pictures/

# Playwright MCP scratch output (screenshots, and any file it downloads)
.playwright-mcp/
